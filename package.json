{
  "dependencies": {},
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@types/bun": "^1.3.14",
    "@types/node": "^20.10.0",
    "knip": "6.0.6",
    "lefthook": "2.1.10",
    "oxlint": "1.57.0",
    "prettier": "3.9.5",
    "typescript": "5.9.3"
  },
  "name": "codex-agent",
  "scripts": {
    "build": "bun build src/cli.ts --outdir dist --target node",
    "check:tests": "bun src/check-test-discipline/index.ts",
    "format": "biome check --write . && prettier --write .",
    "format:check": "biome check . && prettier --check .",
    "knip": "knip",
    "lint": "oxlint --deny-warnings",
    "prepare": "lefthook install || true",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "validate": "bun src/gate/index.ts"
  },
  "type": "module",
  "version": "1.0.0"
}
